FROM docker.io/library/ubuntu:24.04 AS builder
ARG BUILD_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake make python3 ca-certificates libapriltag-dev libopencv-calib3d-dev \
    libopencv-imgproc-dev libopencv-features2d-dev nlohmann-json3-dev makeself \
    && rm -rf /var/lib/apt/lists/*
COPY frame/third_party/xfeat/manifest.json /src/frame/third_party/xfeat/manifest.json
COPY frame/pack/fetch-photo-models.py /src/frame/pack/fetch-photo-models.py
RUN python3 /src/frame/pack/fetch-photo-models.py \
    --output /opt/framephone/share/framephone/xfeat --torch-wheel /tmp/photo-wheels
COPY LICENSE /src/LICENSE
COPY frame /src/frame
RUN FRAMEPHONE_BUILD_JOBS="$BUILD_JOBS" FRAMEPHONE_INSTALL_DIR=/opt/framephone \
    bash /src/frame/pack/build-native.sh
RUN install -Dm644 /usr/share/doc/nlohmann-json3-dev/copyright \
    /opt/framephone/share/framephone/third_party/nlohmann-json-copyright
RUN cc -O2 -std=gnu11 -static -Wall -Wextra -o /opt/framephone/bin/framephone-camd \
    /src/frame/third_party/frametop/camd/camd.c \
    /src/frame/third_party/frametop/camd/tp.c \
    /src/frame/third_party/frametop/camd/xrcams.c -lm \
    && /opt/framephone/bin/framephone-camd --help
RUN cp -a /src/frame/desktop /opt/framephone/desktop \
    && cp -a /src/frame/third_party/frametop /opt/framephone/share/framephone/third_party/
FROM docker.io/library/ubuntu:24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libapriltag3t64 libopencv-calib3d406t64 python3-tk python3-pil \
    python3-pip python3-opencv python3-numpy ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /tmp/photo-wheels /tmp/photo-wheels
COPY frame/pack/requirements-photo.txt /tmp/requirements-photo.txt
RUN python3 -m pip install --disable-pip-version-check --only-binary=:all: --no-cache-dir --no-deps --target /opt/framephone/python \
    /tmp/photo-wheels/*.whl -r /tmp/requirements-photo.txt \
    && rm -rf /tmp/photo-wheels /tmp/requirements-photo.txt
COPY --from=builder /opt/framephone /opt/framephone
RUN FRAMEPHONE_PHOTO_MODELS=/opt/framephone/share/framephone/xfeat \
    FRAMEPHONE_PHOTO_WORKER=/opt/framephone/desktop/learned_worker.py \
    /opt/framephone/bin/framephone-photo --model-self-test
RUN dpkg-query -W -f='${binary:Package}\t${Version}\t${Architecture}\n' \
    > /opt/framephone/share/framephone/runtime-packages.txt
LABEL org.opencontainers.image.title="FramePhone" \
      org.opencontainers.image.description="Phone telemetry and calibrated fixed-photo stereo tracking" \
      org.opencontainers.image.licenses="MIT"
ENTRYPOINT ["/opt/framephone/bin/framephone-photo"]
CMD ["--help"]

FROM builder AS package
ARG TARGET_ARCH
COPY --from=runtime / /payload/rootfs/
COPY frame/pack/AppRun /payload/AppRun
RUN python3 /src/frame/pack/prepare-runtime.py /payload/rootfs \
    && printf '%s\n' "$TARGET_ARCH" > /payload/architecture.txt \
    && chmod 755 /payload/AppRun \
    && mkdir /out \
    && cp /usr/share/doc/makeself/copyright /payload/makeself-copyright \
    && cp /usr/share/common-licenses/GPL-2 /payload/makeself-GPL-2 \
    && makeself --quiet --nox11 --gzip --sha256 --tar-format posix /payload /out/FramePhone.run "FramePhone" ./AppRun

FROM scratch AS executable
COPY --from=package /out/FramePhone.run /out/FramePhone.run
CMD ["/out/FramePhone.run"]
